<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs: a frosted glass card (the theme blurs what is behind it on Android 12 and later), a sheen from the top left and a bright rim, inset from the screen's sides -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="24dp" android:insetBottom="24dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle"><corners android:radius="30dp" /><solid android:color="@color/glass_fill_strong" /></shape>
        </item>
        <item>
            <shape android:shape="rectangle"><corners android:radius="30dp" /><gradient android:angle="315" android:startColor="@color/glass_sheen_top" android:endColor="@color/glass_sheen_bottom" /></shape>
        </item>
        <item>
            <shape android:shape="rectangle"><corners android:radius="30dp" /><stroke android:width="1dp" android:color="@color/glass_edge" /></shape>
        </item>
    </layer-list>
</inset>

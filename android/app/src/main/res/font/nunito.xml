<?xml version="1.0" encoding="utf-8"?>
<!-- Nunito (SIL OFL 1.1, assets/licenses/Nunito-OFL.txt): one variable font, a weight of it per entry, so a TextView's textStyle and the theme's fontFamily pick the weight -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/nunito_vf" android:fontWeight="400" android:fontStyle="normal" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/nunito_vf" android:fontWeight="500" android:fontStyle="normal" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/nunito_vf" android:fontWeight="600" android:fontStyle="normal" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/nunito_vf" android:fontWeight="700" android:fontStyle="normal" android:fontVariationSettings="'wght' 700" />
    <font android:font="@font/nunito_vf" android:fontWeight="800" android:fontStyle="normal" android:fontVariationSettings="'wght' 800" />
</font-family>

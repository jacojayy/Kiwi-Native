<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog opens: it grows from 92 % and fades in -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1" android:pivotX="50%" android:pivotY="50%" android:duration="220" />
</set>

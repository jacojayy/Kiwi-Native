<?xml version="1.0" encoding="utf-8"?>
<!-- A page opens: it fades in and rises a little from the right (Kiwi.WindowAnim) -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="240" />
    <translate android:fromXDelta="7%p" android:toXDelta="0" android:duration="280" />
</set>

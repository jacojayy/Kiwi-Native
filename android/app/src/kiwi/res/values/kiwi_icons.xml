<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The two colours of the Kiwi icons (drawable/pi_*.xml): the shell's ink and the kernel. hernandez.kiwinative.kiwi.ui.Icons applies one of the styles below
         to a copy of the activity's theme and draws the icon with it; it looks them up by name, so a build without this folder keeps its emoji -->
    <attr name="pnIconInk" format="color" />
    <attr name="pnIconKernel" format="color" />

    <!-- A row's tile, a page's button: the text colour, the kernel in the accent (yellow in the dark theme, deep gold on cream) -->
    <style name="KiwiIcon">
        <item name="pnIconInk">@color/bn_text</item>
        <item name="pnIconKernel">@color/bn_accent</item>
    </style>
    <!-- A sidebar or drawer entry that is not selected: the quieter text colour -->
    <style name="KiwiIconQuiet" parent="KiwiIcon">
        <item name="pnIconInk">@color/bn_text_2</item>
    </style>
    <!-- The selected entry, on banana yellow: shell and kernel in the brown of text on yellow -->
    <style name="KiwiIconOnKiwi">
        <item name="pnIconInk">@color/bn_on_kiwi</item>
        <item name="pnIconKernel">@color/bn_on_kiwi</item>
    </style>

    <!-- The drawer of the sections on a phone (hernandez.kiwinative.kiwi.ui.SettingsPage): it slides in a little from the left and fades in (Motion.ENTER), out with a fade -->
    <style name="KiwiDrawer">
        <item name="android:windowEnterAnimation">@anim/kiwi_drawer_in</item>
        <item name="android:windowExitAnimation">@anim/kiwi_drawer_out</item>
    </style>
    <style name="KiwiDrawerReduced">
        <item name="android:windowEnterAnimation">@anim/kiwi_fade_in</item>
        <item name="android:windowExitAnimation">@anim/kiwi_fade_out</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The in-game menus' solid icons (drawable/pis_*.xml, design/kiwi-native/icons SOLID): a solid shell and a kernel in the accent.
         hernandez.kiwinative.kiwi.ingame.Look applies one of the styles below to a copy of the theme and draws the icon with it -->
    <attr name="pnSolidBase" format="color" />
    <attr name="pnSolidAccent" format="color" />

    <!-- The quick menu's rail at rest: a muted grey with a muted banana -->
    <style name="KiwiSolidRest">
        <item name="pnSolidBase">#FFA3BD86</item>
        <item name="pnSolidAccent">#FF6E9446</item>
    </style>
    <!-- The selected tab, on the kiwi-brown block: kiwi cream with banana yellow -->
    <style name="KiwiSolidSelected">
        <item name="pnSolidBase">#FF0F2008</item>
        <item name="pnSolidAccent">#FFF4EDCB</item>
    </style>
    <!-- The game menu's rows and the quick menu's back button: the panel's text colour with banana yellow -->
    <style name="KiwiSolidMenu">
        <item name="pnSolidBase">#FFEEF8DC</item>
        <item name="pnSolidAccent">#FF9AD64A</item>
    </style>
    <!-- The game page's Cheats row (upstream's strings.xml): the cheats are the quick menu's Cheats tab now (InGamePanel) -->
    <string name="cheats_on">Cheat list in the quick menu (Cheats tab). Cheated values are stored when the game saves</string>
</resources>
